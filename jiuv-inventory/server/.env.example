# 数据库连接字符串（本地开发用 SQLite，生产环境换 PostgreSQL）
DATABASE_URL="postgresql://user:password@localhost:5432/jiuv_inventory?schema=public"

# JWT 密钥
JWT_SECRET="jiuv-secret-change-in-production"

# 服务端口
PORT=3001

# 前端地址（CORS）
CLIENT_URL=http://localhost:5173

# 生产环境初始化店主账号
SEED_OWNER_PHONE=13800000001
SEED_OWNER_PASSWORD=change-this-before-production
